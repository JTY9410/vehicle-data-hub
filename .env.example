# Mac 서버 / 로컬 Docker Compose용. 시크릿은 커밋하지 말 것.
# 서버: 레포 compose + docker-compose.override.yml + 이 파일을 .env 로 복사해 채움.

# --- 필수 ---
SECRET_KEY=change-me-in-production
# Compose가 db 서비스로 덮어씀. 로컬 단독 실행 시에만 직접 사용.
DATABASE_URL=postgresql+psycopg://vehicle:vehicle@db:5432/vehicle

# --- 프록시 / 바인딩 (nginx → 127.0.0.1) ---
# 서버 nginx 1단 뒤: TRUST_PROXY=1. 로컬 HTTP도 ProxyFix 만 쓸 거면 1 가능.
TRUST_PROXY=1
# 사내 https 서버만 1. 로컬 http://127.0.0.1 로그인은 반드시 0
SESSION_COOKIE_SECURE=0
FORCE_HTTPS=0
# 사내 Mac 서버: 1 로 두면 SECRET_KEY 예시값이면 기동 실패 (nginx 502 방지)
REQUIRE_PRODUCTION_ENV=0
# PROXY_FIX_HOPS=1
WEB_BIND=127.0.0.1
WEB_PORT=8010

# --- 관리자 (선택: 비어 있으면 /setup 또는 seed-admin) ---
ADMIN_USERNAME=
ADMIN_PASSWORD=

# --- Hub → 크롤 API ---
CRAWL_API_URL=https://crawl.wecarmobility.co.kr
# 스케줄러(--profile scheduler) 기동 시 필수. 키는 별도 채널.
CRAWL_API_KEY=

# --- API 한도 (선택) ---
# API_PER_PAGE_MAX=100
# API_PER_PAGE_MAX_WITH_TEXT=100

# --- Supabase → 내장 DB 1회 이전 (서버에서만, 커밋 금지) ---
# SUPABASE_DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres
# ./scripts/migrate_from_supabase.sh
